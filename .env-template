## Copy to .env (project root) and fill in the keys. Every setting has a default
## (in core/src/config/config.py); relative paths resolve from the project root.

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL_NAME=claude-opus-5-5
# true  → Anthropic API (needs ANTHROPIC_API_KEY and credits)
# false → local Claude Code CLI, using the account it is logged in with (`claude` must be installed)
ANTHROPIC_API=true
# API key from https://console.anthropic.com (billed per token, separate from a Claude subscription)
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
# Thinking depth / token spend: low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# RAG (property, WhatsApp and finance agents)
# ---------------------------------------------------------------------------
STORE_TYPE=pinecone
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
PINECONE_API_KEY=<PINECONE_API_KEY>
PINECONE_INDEX_NAME=<PINECONE_INDEX>
PINECONE_ENVIRONMENT=gcpstart
# Finance agent's own index (default: PINECONE_INDEX_NAME, else finance-agent)
# FINANCE_PINECONE_INDEX_NAME=
# URL list for `python -m agents.property.gatherers.data_collector` (one URL per line)
URLS_FILE=agents/property/urls.txt
# Selenium scraping browser WebDriver URL (used by agents/property/scraping/scrape_se.py)
SBR_WEBDRIVER=

# ---------------------------------------------------------------------------
# Prompts, registries and local databases (these are the defaults)
# ---------------------------------------------------------------------------
PROMPT_FILE=agents/property/prompts/System_Prompt.txt
ROUTER_PROMPT_FILE=orchestrator/prompts/router.txt
SYNTHESISER_PROMPT_FILE=orchestrator/prompts/synthesiser.txt
CONFIRMATION_PROMPT_FILE=orchestrator/prompts/confirmation.txt
AGENTS_FILE=agents.json
MCP_FILE=mcp.json
# Agent chat history, the router's conversation memory and FBR session ids
SESSION_DB_FILE=sessions.db
# Agent history window (turns)
MAX_HISTORY_TURNS=10
# Orchestrator checkpointer — holds only conversations paused for a confirmation
CHECKPOINT_DB_FILE=checkpoints.db

# ---------------------------------------------------------------------------
# Clients
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<TELEGRAM_TOKEN>
# Local faster-whisper model for Telegram voice notes: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# REST API key (X-API-Key header). Leave empty to disable authentication
API_KEY=
# Prompt the cron job sends every 30 minutes
CRON_SEARCH_PROMPT="Find 2-bedroom apartments in Poland under 1000"

# ---------------------------------------------------------------------------
# Expense tracker and FBR tax filing
# ---------------------------------------------------------------------------
# Folder for expenses.db. Leave empty for the per-user data dir
# (~/Library/Application Support/uk-agents/expenses on macOS, ~/.local/share/uk-agents/expenses
# on Linux, %APPDATA%\uk-agents\expenses on Windows).
EXPENSES_DIR=
# Project holding the fbr-iris-filing skill (default ~/work/fbr-tax-filing)
FBR_TAX_DIR=
# Folder for the FBR agent's filings.db (default: per-user data dir /fbr_tax)
FBR_TAX_DATA_DIR=
# Tool calls one filing step may take
FBR_TAX_MAX_TURNS=200

# ---------------------------------------------------------------------------
# LangSmith tracing
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=<LANG_SMITH_API_KEY>
LANGCHAIN_PROJECT=uk-agents

# ---------------------------------------------------------------------------
# WhatsApp (Green API — https://green-api.com)
# 1. Register at green-api.com and create a free instance.
# 2. In the dashboard, click "Scan QR code" and scan with WhatsApp on your phone.
# 3. Enable "Incoming webhooks" in the instance settings.
# 4. Copy the Instance ID and Token below.
# ---------------------------------------------------------------------------
WHATSAPP_INSTANCE_ID=<YOUR_INSTANCE_ID>
WHATSAPP_INSTANCE_TOKEN=<YOUR_INSTANCE_TOKEN>
# Group chat ID to monitor (format: 120363xxxxxxxxx@g.us).
# To find it: python -c "from agents.whatsapp.green_api_client import GreenAPIClient; [print(c['id'], c.get('name')) for c in GreenAPIClient().get_contacts() if c.get('type')=='group']"
WHATSAPP_GROUP_ID=<GROUP_CHAT_ID>
# Name the LLM checks for mentions (default: Uzair)
WHATSAPP_USER_NAME=Uzair
# Auto-reply sent when the user is mentioned while away
WHATSAPP_AWAY_MESSAGE=Uzair is away from his phone right now. He'll get back to you soon!
# Seconds between polls when the notification queue is empty (default: 2)
WHATSAPP_POLL_INTERVAL=2

# ---------------------------------------------------------------------------
# Mail monitor
# ---------------------------------------------------------------------------
# JSON array — one object per inbox you want to monitor.
# Gmail users: generate an App Password at https://myaccount.google.com/apppasswords
# Outlook users: enable IMAP in settings and use your regular password (or App Password if MFA is on)
#
# Example (single account):
# MAIL_ACCOUNTS=[{"email":"uzair@gmail.com","imap_host":"imap.gmail.com","imap_port":993,"password":"your-app-password"}]
#
# Example (multiple accounts):
# MAIL_ACCOUNTS=[{"email":"uzair@gmail.com","imap_host":"imap.gmail.com","password":"pw1"},{"email":"uzair@outlook.com","imap_host":"outlook.office365.com","password":"pw2"}]
MAIL_ACCOUNTS=[]
# How often to fetch new emails from each inbox (hours)
MAIL_CHECK_INTERVAL_HOURS=2
# How often to send the accumulated summary (hours)
MAIL_SUMMARY_INTERVAL_HOURS=5
# WhatsApp group chat ID to deliver the summary to (format: 120363xxxxxxxxx@g.us)
# Leave empty to write the summary to the application log only
MAIL_SUMMARY_WHATSAPP_GROUP_ID=
# SQLite file that records which emails have already been summarised (no repetitions)
MAIL_SEEN_DB=mail_seen.db
