      "link_selector": "a[href*='/bien/']",
      "fields": {
        "title": "a > div > div > p",
        "price": {
          "selector": ":scope",
          "pattern": "(€\\s?\\d[\\d.,]*(?:\\s\\d{3})*|\\d[\\d.,]*(?:\\s\\d{3})*\\s?€)"
        },
        "area": {
          "selector": ":scope",
          "pattern": "(?<![\\d.,])([1-9]\\d{0,2}(?:\\.\\d{3})+|[1-9]\\d*(?:[.,]\\d+)?)\\s?m(?:²|2)(?![\\w²])"
        },
        "rooms": {
          "selector": ":scope",
          "pattern": "(\\d+)\\s*(?:ch\\b|ch\\.|chambre)"
        },
        "city": {
          "selector": "a > div > div > p",
          "pattern": "-\\s+([1-9]\\d{3}\\s+.+?)\\s+-\\s"
        },
        "photo": {
          "selector": "img",
          "attr": "src"
        }
      },
      "next_page_selector": "a[href*='page=']:-soup-contains('Next')",
      "max_pages": 2,
      "currency": "EUR",
      "enabled": true
    },
